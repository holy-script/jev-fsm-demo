# Copy to .env (or .env.local) and fill in. Never commit the real file.
# These are read server-side only (app/api/jev/route.ts) so the key never reaches the browser.

# --- Jev connection ---
TYPESAFE_API_KEY=
# Base URL of the TypeSafe API. The route POSTs to `${TYPESAFE_BASE_URL}/v1/systemone`.
TYPESAFE_BASE_URL=https://api.typesafe.ai
# Model name or alias from GET /v1/models (e.g. jev-latest)
JEV_MODEL=jev-latest

# --- Tuning ---
# Server-side request timeout; on timeout the enemy falls back to the rule brain for that tick
JEV_TIMEOUT_MS=2500

# --- Client-side (exposed to the browser, no secrets here) ---
# How often the enemy asks Jev for a decision (ms)
NEXT_PUBLIC_JEV_DECISION_INTERVAL_MS=600
